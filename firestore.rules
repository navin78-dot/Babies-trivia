rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Anyone in this list gets the Host tab (open/close rounds, wipe scores) on every game.
    function isHost() {
      return signedIn() && request.auth.token.email in [
        'navin78@gmail.com'
      ];
    }

    // Sister games (games/<id>.json in the repo). Each keeps its own rounds, scores, chat,
    // poll, presence, profiles, suggestions, requests and site config under games/<id>/,
    // with the same rules as the original game below. Nothing is shared between games.
    function knownGame(game) {
      return game in ['hamps'];
    }

    // ---------- the original game: data at the top level ----------

    // Round open/closed state. Everyone reads it, only the host changes it.
    match /site/config {
      allow read: if signedIn();
      allow write: if isHost();
    }

    // Poll options published from the repo (poll.json). Everyone reads, host writes.
    match /site/poll {
      allow read: if signedIn();
      allow write: if isHost();
    }

    // One official score per player per round. Doc id is "<roundId>_<uid>".
    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && scoreId == request.resource.data.roundId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isHost();
    }

    // Who is mid-quiz right now. Each player owns the doc keyed by their uid.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // Nightly poll. One vote per player per day, doc id "<uid>_<YYYY-MM-DD>", changeable until midnight.
    // (The old one-doc-per-player ids are still allowed so nothing breaks.)
    match /votes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (voteId == request.auth.uid || voteId == request.auth.uid + '_' + request.resource.data.day);
      allow delete: if signedIn() && (voteId == request.auth.uid || voteId.matches('^' + request.auth.uid + '_.*'));
    }

    // Future suggestion box. Anyone signed in can drop one in; only the host reads or deletes.
    match /suggestions/{id} {
      allow read, delete: if isHost();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Theme requests the host queues for the next data push.
    match /requests/{id} {
      allow read, write: if isHost();
    }

    // The chat thread. Everyone signed in reads and posts; a message is never edited,
    // and only the host can remove one. Text is capped so a client can't post an essay.
    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update: if false;
      allow delete: if isHost();
    }

    // Player profiles (avatar, chat read marker). Everyone reads, each player writes their own.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write, delete: if signedIn() && request.auth.uid == uid;
    }

    // The original game's quiz rounds, loaded at runtime. Everyone signed in can read
    // them; only the host (or the service account, which bypasses rules) can write.
    match /rounds/{roundId} {
      allow read: if signedIn();
      allow write: if isHost();
    }

    // ---------- sister games: the same rules under games/<id>/ ----------

    match /games/{game} {
      // The game document itself holds nothing.
      allow read, write: if false;

      match /site/config {
        allow read: if signedIn() && knownGame(game);
        allow write: if isHost() && knownGame(game);
      }

      match /site/poll {
        allow read: if signedIn() && knownGame(game);
        allow write: if isHost() && knownGame(game);
      }

      match /scores/{scoreId} {
        allow read: if signedIn() && knownGame(game);
        allow create: if signedIn() && knownGame(game)
          && request.resource.data.uid == request.auth.uid
          && scoreId == request.resource.data.roundId + '_' + request.auth.uid;
        allow update: if false;
        allow delete: if isHost() && knownGame(game);
      }

      match /presence/{uid} {
        allow read: if signedIn() && knownGame(game);
        allow write, delete: if signedIn() && knownGame(game) && request.auth.uid == uid;
      }

      match /votes/{voteId} {
        allow read: if signedIn() && knownGame(game);
        allow create, update: if signedIn() && knownGame(game)
          && request.resource.data.uid == request.auth.uid
          && voteId == request.auth.uid + '_' + request.resource.data.day;
        allow delete: if signedIn() && knownGame(game) && voteId.matches('^' + request.auth.uid + '_.*');
      }

      match /suggestions/{id} {
        allow read, delete: if isHost() && knownGame(game);
        allow create: if signedIn() && knownGame(game) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      match /requests/{id} {
        allow read, write: if isHost() && knownGame(game);
      }

      match /chat/{id} {
        allow read: if signedIn() && knownGame(game);
        allow create: if signedIn() && knownGame(game)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200;
        allow update: if false;
        allow delete: if isHost() && knownGame(game);
      }

      match /profiles/{uid} {
        allow read: if signedIn() && knownGame(game);
        allow write, delete: if signedIn() && knownGame(game) && request.auth.uid == uid;
      }

      match /rounds/{roundId} {
        allow read: if signedIn() && knownGame(game);
        allow write: if isHost() && knownGame(game);
      }
    }
  }
}
